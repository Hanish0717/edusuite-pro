datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Student {
  id                  String               @id @default(uuid())
  rollNumber          String               @unique
  name                String
  email               String               @unique
  password            String
  role                String               @default("student")
  department          String?
  semester            Int?                 @default(6)
  section             String?
  year                Int?
  studentType         String?              // "Day Scholar" | "Hostel" | "College Bus"
  parentId            String?
  parent              Parent?              @relation(fields: [parentId], references: [id])
  cgpa                Float?               @default(8.85)
  creditsEarned       Int?                 @default(112)
  avatarUrl           String?
  courseRegistrations CourseRegistration[]
  nptelRecords        NptelRecord[]
  attendanceRecords   AttendanceRecord[]
  notifications       Notification[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Parent {
  id                  String               @id @default(uuid())
  rollNumber          String               @unique
  name                String
  email               String               @unique
  password            String
  role                String               @default("parent")
  department          String?
  students            Student[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Faculty {
  id                  String               @id @default(uuid())
  rollNumber          String               @unique
  name                String
  email               String               @unique
  password            String
  role                String               @default("faculty") // "hod" or "faculty"
  department          String?
  subjectAllocations  SubjectAllocation[]
  lmsResources        LmsResource[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Admin {
  id                  String               @id @default(uuid())
  rollNumber          String               @unique
  name                String
  email               String               @unique
  password            String
  role                String               @default("admin") // "super_admin", "admin", "principal", "vice_principal", "dean", etc.
  department          String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Course {
  id                  String               @id @default(uuid())
  code                String               @unique
  name                String
  faculty             String
  credits             Float
  category            String
  semester            Int
  department          String?
  sections            String?
  isOffered           Boolean              @default(false)
  status              String               @default("Draft")
  courseRegistrations CourseRegistration[]
  nptelRecords        NptelRecord[]
  subjectAllocations  SubjectAllocation[]
  lmsResources        LmsResource[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model LmsResource {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  title       String
  unit        String   // e.g. "Unit 1", "Unit 2"
  fileUrl     String
  fileType    String   // "pdf", "docx", "pptx", "video", etc.
  fileSize    String   // e.g. "2.4 MB"
  facultyId   String
  faculty     Faculty  @relation(fields: [facultyId], references: [id])
  uploadedAt  DateTime @default(now())
}

model SubjectAllocation {
  id                  String   @id @default(uuid())
  facultyId           String
  faculty             Faculty  @relation(fields: [facultyId], references: [id])
  courseId            String
  course              Course   @relation(fields: [courseId], references: [id])
  section             String
  semester            Int
  academicYear        String   @default("2024-25")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model CourseRegistration {
  id           String   @id @default(uuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id])
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id])
  status       String   @default("APPROVED") // "APPROVED" | "PENDING" | "REJECTED"
  registeredAt DateTime @default(now())
}

model NptelRecord {
  id            String   @id @default(uuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id])
  score         Float
  certificateUrl String?
  createdAt     DateTime @default(now())
}

model AttendanceRecord {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  date      DateTime
  status    String   // "PRESENT" | "ABSENT" | "OD" | "LEAVE"
  subject   String
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   @default("INFO")
  createdAt DateTime @default(now())
}
