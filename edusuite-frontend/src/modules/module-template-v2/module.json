{
  "name": "ModuleName",
  "version": "1.0.0",
  "category": "Operational Core",
  "owner": "Module Owner Office",
  "icon": "Box",
  "permissions": [
    "VIEW_MODULE",
    "CREATE_MODULE",
    "UPDATE_MODULE",
    "DELETE_MODULE",
    "EXPORT_MODULE"
  ],
  "dependencies": [
    "Notifications"
  ],
  "routes": [
    "/module-path",
    "/module-path/:id"
  ],
  "notifications": [
    "module:created_notify"
  ],
  "events": [
    "module:created",
    "module:updated",
    "module:deleted"
  ],
  "futureApis": [
    "GET /api/v1/module",
    "POST /api/v1/module"
  ]
}
